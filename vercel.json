{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "frontend",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/send-due-campaigns",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-index.xml", "destination": "/api/sitemap-index" },
    { "source": "/sitemap-editorials.xml", "destination": "/api/sitemap-editorials" },
    { "source": "/sitemap-articles.xml", "destination": "/api/sitemap-articles" },
    { "source": "/sitemap-films.xml", "destination": "/api/sitemap-films" },
    { "source": "/editorial/:slug", "destination": "/api/seo/editorial/:slug" },
    { "source": "/article/:slug", "destination": "/api/seo/article/:slug" },
    { "source": "/film/:slug", "destination": "/api/seo/film/:slug" },
    { "source": "/short/:slug", "destination": "/api/seo/short/:slug" },
    { "source": "/go/:id", "destination": "/api/go/:id" }
  ],
  "redirects": [
    { "source": "/.env",                "destination": "/404.html", "permanent": false },
    { "source": "/.env.local",          "destination": "/404.html", "permanent": false },
    { "source": "/.env.production",     "destination": "/404.html", "permanent": false },
    { "source": "/.env.development",    "destination": "/404.html", "permanent": false },
    { "source": "/.git/:path*",         "destination": "/404.html", "permanent": false },
    { "source": "/.aws/:path*",         "destination": "/404.html", "permanent": false },
    { "source": "/wp-admin/:path*",     "destination": "/404.html", "permanent": false },
    { "source": "/wp-login.php",        "destination": "/404.html", "permanent": false },
    { "source": "/wp-config.php",       "destination": "/404.html", "permanent": false },
    { "source": "/wp-content/:path*",   "destination": "/404.html", "permanent": false },
    { "source": "/wp-includes/:path*",  "destination": "/404.html", "permanent": false },
    { "source": "/wordpress/:path*",    "destination": "/404.html", "permanent": false },
    { "source": "/phpmyadmin/:path*",   "destination": "/404.html", "permanent": false },
    { "source": "/xmlrpc.php",          "destination": "/404.html", "permanent": false },
    { "source": "/backup/:path*",       "destination": "/404.html", "permanent": false },
    { "source": "/backups/:path*",      "destination": "/404.html", "permanent": false },
    { "source": "/db/:path*",           "destination": "/404.html", "permanent": false },
    { "source": "/database/:path*",     "destination": "/404.html", "permanent": false },
    { "source": "/dump/:path*",         "destination": "/404.html", "permanent": false },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "m.papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "m.pap-magazine.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pap-magazine.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    { "source": "/ko", "destination": "/", "permanent": true },
    { "source": "/ko/", "destination": "/", "permanent": true },
    { "source": "/ko/about", "destination": "/about.html", "permanent": true },
    { "source": "/ko/about/", "destination": "/about.html", "permanent": true },
    { "source": "/ko/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/ko/contact/", "destination": "/contact.html", "permanent": true },
    { "source": "/ko/business", "destination": "/business.html", "permanent": true },
    { "source": "/ko/business/", "destination": "/business.html", "permanent": true },
    { "source": "/ko/filmList", "destination": "/", "permanent": true },
    { "source": "/ko/filmList/", "destination": "/", "permanent": true },
    { "source": "/ko/category/:cat*", "destination": "/", "permanent": true },
    { "source": "/ko/:slug", "destination": "/editorial/:slug", "permanent": true },
    { "source": "/ko/:slug/", "destination": "/editorial/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|webp|avif|gif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(woff|woff2|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/editorial/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large" }
      ]
    },
    {
      "source": "/article/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large" }
      ]
    },
    {
      "source": "/film/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-video-preview:-1" }
      ]
    },
    {
      "source": "/short/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-video-preview:-1" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://platform.instagram.com https://connect.facebook.net https://js.stripe.com https://*.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.anthropic.com https://pap-korea-bucket.s3.ap-northeast-2.amazonaws.com https://www.google-analytics.com https://*.vercel-insights.com wss://*.supabase.co; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://platform.instagram.com https://www.instagram.com https://js.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://www.paypal.com; upgrade-insecure-requests" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "cleanUrls": true
}
