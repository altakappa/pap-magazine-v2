{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "frontend",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/send-due-campaigns",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-index.xml", "destination": "/api/sitemap-index" },
    { "source": "/sitemap-editorials.xml", "destination": "/api/sitemap-editorials" },
    { "source": "/sitemap-articles.xml", "destination": "/api/sitemap-articles" },
    { "source": "/sitemap-films.xml", "destination": "/api/sitemap-films" },
    { "source": "/editorial/:slug", "destination": "/api/seo/editorial/:slug" },
    { "source": "/article/:slug", "destination": "/api/seo/article/:slug" },
    { "source": "/film/:slug", "destination": "/api/seo/film/:slug" },
    { "source": "/short/:slug", "destination": "/api/seo/short/:slug" },
    { "source": "/go/:id", "destination": "/api/go/:id" }
  ],
  "redirects": [
    {
      "//": "QA #193 — preemptive 404 for known vulnerability-scanner paths. Returns a clean 404 instead of letting the scanner keep retrying variants. Comment fields ('//') are ignored by Vercel.",
      "source": "/.env:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.git/:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.aws/:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt",
      "permanent": false
    },
    {
      "source": "/wp-:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/wordpress/:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/phpmyadmin/:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/(backup|backups|db|database|dump|sql)/:rest*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:path*.(sql|bak|backup|old|tmp|swp|log)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "m.papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "m.pap-magazine.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pap-magazine.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    { "source": "/ko", "destination": "/", "permanent": true },
    { "source": "/ko/", "destination": "/", "permanent": true },
    { "source": "/ko/about", "destination": "/about.html", "permanent": true },
    { "source": "/ko/about/", "destination": "/about.html", "permanent": true },
    { "source": "/ko/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/ko/contact/", "destination": "/contact.html", "permanent": true },
    { "source": "/ko/business", "destination": "/business.html", "permanent": true },
    { "source": "/ko/business/", "destination": "/business.html", "permanent": true },
    { "source": "/ko/filmList", "destination": "/", "permanent": true },
    { "source": "/ko/filmList/", "destination": "/", "permanent": true },
    { "source": "/ko/category/:cat*", "destination": "/", "permanent": true },
    { "source": "/ko/:slug", "destination": "/editorial/:slug", "permanent": true },
    { "source": "/ko/:slug/", "destination": "/editorial/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|webp|avif|gif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(woff|woff2|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/editorial/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large" }
      ]
    },
    {
      "source": "/article/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large" }
      ]
    },
    {
      "source": "/film/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-video-preview:-1" }
      ]
    },
    {
      "source": "/short/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-video-preview:-1" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "//": "QA #193 — bumped HSTS to 2 years + added preload directive to qualify for the Chrome HSTS preload list (https://hstspreload.org/). After submission Chrome/Firefox/Safari ship the redirect in-browser, so even first-visit users skip HTTP entirely.",
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        {
          "//": "QA #193 — CSP-Report-Only first. The PAP frontend has lots of inline scripts, multiple Supabase/S3/YouTube origins, embedded Instagram + Vimeo iframes, etc. — enforcing a strict CSP up front would brick the site. Report-only lets us watch real violations roll in (Vercel logs / browser console) before flipping to enforcing. The 'frame-ancestors none' line + X-Frame-Options give double clickjacking defence regardless of enforcement mode.",
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://platform.instagram.com https://connect.facebook.net https://js.stripe.com https://*.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.anthropic.com https://pap-korea-bucket.s3.ap-northeast-2.amazonaws.com https://www.google-analytics.com https://*.vercel-insights.com wss://*.supabase.co; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://platform.instagram.com https://www.instagram.com https://js.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://www.paypal.com; upgrade-insecure-requests"
        },
        {
          "//": "QA #193 — minimal cross-origin policies. COEP/COOP keep our tabs isolated from cross-origin actors so a vulnerable third-party iframe can't reach back into the main page. unsafe-none for COEP because we embed YouTube + Instagram iframes that don't ship CORP headers.",
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "cleanUrls": true
}
