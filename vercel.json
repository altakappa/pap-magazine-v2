{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "frontend",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "//": "SEO: server-rendered editorial pages. /editorial/:slug returns full HTML with per-article meta tags + schema.org Article so Google can index them. The SPA hydrates on top for the rich UX.",
      "source": "/editorial/:slug",
      "destination": "/api/seo/editorial/:slug"
    }
  ],
  "redirects": [
    {
      "//": "Domain consolidation: papkorea.com is the legacy alias. All traffic 301-redirects to pap-magazine.com so search engines index a single canonical domain and SEO juice consolidates. Users typing papkorea.com still 'work' — they just land on pap-magazine.com. Path is preserved.",
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "//": "Legacy mobile subdomain: m.papkorea.com was historically the most-indexed PAP property in Google. Consolidating it into the canonical domain reclaims that authority. Path is preserved so /dystopia/, /category/Editorial/ etc. still resolve.",
      "source": "/:path*",
      "has": [{ "type": "host", "value": "m.papkorea.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "//": "Same treatment for m.pap-magazine.com if anyone ever types it.",
      "source": "/:path*",
      "has": [{ "type": "host", "value": "m.pap-magazine.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    {
      "//": "Apex-to-www on the canonical domain itself, in case anyone hits pap-magazine.com without the www subdomain.",
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pap-magazine.com" }],
      "destination": "https://www.pap-magazine.com/:path*",
      "permanent": true
    },
    { "source": "/ko", "destination": "/", "permanent": true },
    { "source": "/ko/", "destination": "/", "permanent": true },
    { "source": "/ko/about", "destination": "/about.html", "permanent": true },
    { "source": "/ko/about/", "destination": "/about.html", "permanent": true },
    { "source": "/ko/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/ko/contact/", "destination": "/contact.html", "permanent": true },
    { "source": "/ko/business", "destination": "/business.html", "permanent": true },
    { "source": "/ko/business/", "destination": "/business.html", "permanent": true },
    { "source": "/ko/filmList", "destination": "/", "permanent": true },
    { "source": "/ko/filmList/", "destination": "/", "permanent": true },
    { "source": "/ko/category/:cat*", "destination": "/", "permanent": true },
    { "source": "/ko/:slug", "destination": "/editorial/:slug", "permanent": true },
    { "source": "/ko/:slug/", "destination": "/editorial/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "cleanUrls": true
}
