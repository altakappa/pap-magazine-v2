# ============================================================
# PAP Magazine Migration - Environment Variables
# ============================================================
# 이 파일을 복사해서 .env 파일을 만들고 실제 값을 넣어주세요.
#   cp .env.example .env
# ============================================================

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-northeast-2
S3_BUCKET=pap-korea-bucket

# --- Supabase ---
# Supabase 대시보드 → Settings → API → Project URL
SUPABASE_URL=https://igcazquhkwxtqsaqpznx.supabase.co
# Supabase 대시보드 → Settings → API Keys → Secret keys → "newline" 키 사용
# ⚠️ 주의: 이건 secret key입니다. 절대 Git/깃허브에 커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_BUCKET=media

# --- Migration Settings ---
# 동시 업로드 개수 (늘리면 빠르지만 네트워크 부하 증가)
CONCURRENCY=10
# 재시도 최대 횟수
MAX_RETRIES=3
