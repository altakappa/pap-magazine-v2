# =============================================
# PAP Magazine - Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# --- Supabase (REQUIRED) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUz...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUz...

# --- PortOne V2 (REQUIRED for subscriptions in Korea) ---
# Get from PortOne dashboard → 결제 연동 → V2 API 시크릿
# Toss Payments is connected as a "Channel" inside PortOne; the channel
# key below identifies which channel to charge through.
PORTONE_API_SECRET=portone-v2-api-secret-here
PORTONE_WEBHOOK_SECRET=portone-webhook-secret-here

# Frontend exposes these via window._PAP_PORTONE_STORE_ID / _CHANNEL_KEY.
# These are PUBLIC (safe to ship to browser) — set them in subscribe.html
# directly OR inject at build time. Channel key is unique per provider:
#   - Toss test channel  → for sandbox / Toss qualification testing
#   - Toss live channel  → after PortOne approves you for production
# Switch between them by swapping channel keys.
PORTONE_STORE_ID=store-...
PORTONE_CHANNEL_KEY=channel-key-...

# --- Stripe (DEPRECATED - kept for legacy compatibility) ---
# We migrated to PortOne for KRW domestic billing. Stripe rows in the
# subscriptions table are read-only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email / SMTP (OPTIONAL - for notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- OAuth (OPTIONAL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Site ---
SITE_URL=https://your-domain.com
