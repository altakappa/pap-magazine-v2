# =============================================
# PAP Magazine - Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# --- Supabase (REQUIRED) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUz...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUz...

# --- PortOne V2 (REQUIRED for subscriptions in Korea) ---
# Get from PortOne dashboard → 결제 연동 → V2 API 시크릿
# Toss Payments is connected as a "Channel" inside PortOne; the channel
# key below identifies which channel to charge through.
PORTONE_API_SECRET=portone-v2-api-secret-here
PORTONE_WEBHOOK_SECRET=portone-webhook-secret-here

# Frontend exposes these via window._PAP_PORTONE_STORE_ID / _CHANNEL_KEY.
# These are PUBLIC (safe to ship to browser) — set them in subscribe.html
# directly OR inject at build time. Channel key is unique per provider:
#   - Toss test channel  → for sandbox / Toss qualification testing
#   - Toss live channel  → after PortOne approves you for production
# Switch between them by swapping channel keys.
PORTONE_STORE_ID=store-...
PORTONE_CHANNEL_KEY=channel-key-...

# --- Stripe (DEPRECATED - kept for legacy compatibility) ---
# We migrated to PortOne for KRW domestic billing. Stripe rows in the
# subscriptions table are read-only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Paddle Billing (해외 결제 레일 — EUR/USD, VAT 는 Paddle MoR 처리) ---
# 국내(PortOne/KRW) + 해외(Paddle) 이원화. migration 059 필요.
# PADDLE_ENV: sandbox | production
PADDLE_ENV=sandbox
# 서버용 API 키 (Paddle 대시보드 > Developer Tools > Authentication)
PADDLE_API_KEY=
# 웹훅 서명 시크릿 (Developer Tools > Notifications > 해당 웹훅의 secret)
PADDLE_WEBHOOK_SECRET=
# 브라우저용 클라이언트 토큰 (공개값 — Developer Tools > Authentication > Client-side tokens)
PADDLE_CLIENT_TOKEN=
# 플랜별 Price ID (Catalog > Products 에서 Product + Price 생성 후 pri_… 복사)
PADDLE_PRICE_STD_M=
PADDLE_PRICE_STD_Y=
PADDLE_PRICE_PREM_M=
PADDLE_PRICE_PREM_Y=

# --- Email / SMTP (OPTIONAL - for notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- OAuth (OPTIONAL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Meta Conversions API (CAPI) — server-side companion to browser Pixel ---
# Pixel ID: matches the one hardcoded in frontend/cookie-consent.js (482856832429283).
# Access Token: generate in Events Manager → 데이터 소스 → PAPMAGAZINE 픽셀 →
#   설정 → 변환 API → 액세스 토큰 생성 (Generate access token).
# Test Code (optional): paste from Events Manager → Test Events tab to route
#   events to the Test Events stream during verification. Remove for prod.
META_PIXEL_ID=482856832429283
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_CODE=

# --- Site ---
SITE_URL=https://your-domain.com
