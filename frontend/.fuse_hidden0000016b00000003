(function(){var c=document.querySelectorAll('.card');var o=new IntersectionObserver(function(e){e.forEach(function(en){if(en.isIntersecting){var idx=Array.from(c).indexOf(en.target);setTimeout(function(){en.target.classList.add('vis')},idx*80);o.unobserve(en.target)}})},{threshold:.08});c.forEach(function(x){o.observe(x)})})();

function openModal(el){
  var href=el.getAttribute('data-href');
  var covTitle=el.querySelector('.cov-title');
  var covCt=el.querySelector('.cov-ct');
  var title=covTitle?covTitle.textContent:'';
  var count=covCt?covCt.textContent:'';
  document.getElementById('modalIssue').textContent=title.toUpperCase();
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalCount').textContent=count.toLowerCase();
  document.getElementById('modalPreview').onclick=function(){location.href=href};
  var m=document.getElementById('subModal');
  m.classList.add('active');
  document.body.style.overflow='hidden';
}
function closeModal(){
  document.getElementById('subModal').classList.remove('active');
  document.body.style.overflow='';
}
document.getElementById('subModal').addEventListener('click',function(e){
  if(e.target===this)closeModal();
});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});
</script>

