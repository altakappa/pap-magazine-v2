<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#060606;--accent:#891717;--text:#e8e8e8;--dim:rgba(255,255,255,0.6);--dimmer:rgba(255,255,255,0.35);--border:rgba(255,255,255,0.06);--display:'Syne',sans-serif;--sans:'DM Sans','Segoe UI',sans-serif}
body{background:var(--bg);color:var(--text);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{text-decoration:none;color:inherit}
@keyframes pulse{0%,100%{opacity:.3}50%{opacity:.8}}

nav{position:fixed;top:0;width:100%;height:64px;background:rgba(6,6,6,.92);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,4vw,48px);z-index:100;border-bottom:1px solid var(--border)}
.nav-back{font-size:12px;letter-spacing:2px;color:var(--dim);font-weight:400;transition:color .3s}
.nav-back:hover{color:#fff}
.nav-logo{height:28px;width:auto}
.nav-right{font-size:10px;letter-spacing:3px;color:var(--dim);transition:color .3s}
.nav-right:hover{color:#fff}

.hero{height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;position:relative;overflow:hidden;padding-top:64px}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg-img{position:absolute;inset:0;background-size:cover;background-position:center;filter:blur(50px) brightness(.15) saturate(.5);transform:scale(1.3);opacity:0;transition:opacity 1.5s ease}
.hero-bg-img.active{opacity:1}
.grain{position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");pointer-events:none;z-index:1}
.hero-content{position:relative;z-index:2;text-align:center}
.hero-content.vis .h-el{opacity:1;transform:translateY(0)}
.h-el{opacity:0;transform:translateY(20px)}
.h-el:nth-child(1){transition:all .8s ease .1s}
.h-el:nth-child(2){transition:all .8s ease .25s}
.h-el:nth-child(3){transition:all .8s ease .4s}
.h-el:nth-child(4){transition:all .8s ease .55s}
.h-el:nth-child(5){transition:all .8s ease .7s}
.hero-pap{height:64px;width:auto;margin-bottom:20px;opacity:.85}
.hero-label{font-size:10px;letter-spacing:8px;color:var(--dimmer);font-weight:300;margin-bottom:28px}
.hero-title{font-family:var(--display);font-size:clamp(48px,10vw,110px);font-weight:800;letter-spacing:-2px;line-height:.88;text-transform:uppercase}
.hero-div{width:40px;height:1px;background:rgba(255,255,255,.2);margin:28px auto}
.hero-badge{font-size:11px;letter-spacing:3px;color:var(--dim);font-weight:500}
.scroll-hint{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;z-index:2;animation:pulse 2.5s ease infinite}
.scroll-hint span{font-size:9px;letter-spacing:3px;color:rgba(255,255,255,.55)}
.scroll-hint-line{width:1px;height:24px;background:linear-gradient(to bottom,rgba(255,255,255,.45),transparent)}

.issues{padding:0 clamp(20px,5vw,80px) 60px}
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px;border-bottom:1px solid var(--border);padding-bottom:16px}
.sec-title{font-family:var(--display);font-size:clamp(26px,3.5vw,42px);font-weight:700;letter-spacing:-.5px}
.sec-count{font-size:10px;letter-spacing:2px;color:var(--dimmer)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.5vw,36px)}
.card{cursor:pointer;opacity:0;transform:translateY(24px);display:block}
.card.vis{opacity:1;transform:translateY(0);transition:opacity .6s ease,transform .6s ease}
.card:hover .cover img{transform:scale(1.04)}
.card:hover .rd{opacity:1;transform:translateY(0)}
.card:hover .hov{opacity:1}
.cover{position:relative;aspect-ratio:3/4;overflow:hidden;margin-bottom:16px}
.cover img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.16,1,.3,1)}
.covlay{position:absolute;inset:0;z-index:2;pointer-events:none}
.mo-badge{position:absolute;top:20px;right:20px;font-size:9px;letter-spacing:2px;color:rgba(255,255,255,.8);background:rgba(0,0,0,.5);backdrop-filter:blur(8px);padding:4px 10px}
.latest-badge{position:absolute;top:20px;right:20px;font-size:8px;letter-spacing:3px;color:#fff;background:var(--accent);padding:3px 10px;font-weight:500;z-index:4}
.cov-bot{position:absolute;bottom:0;left:0;right:0;padding:60px 20px 20px;background:linear-gradient(to top,rgba(0,0,0,.75),transparent)}
.cov-title{font-size:clamp(10px,1vw,12px);font-weight:400;letter-spacing:3px;color:rgba(255,255,255,.75);text-transform:uppercase}
.cov-ct{font-size:9px;letter-spacing:2px;color:rgba(255,255,255,.5);margin-top:4px}
.hov{position:absolute;inset:0;background:rgba(255,255,255,.04);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .35s;z-index:3}
.rd{border:1px solid rgba(255,255,255,.6);padding:10px 28px;font-size:10px;letter-spacing:4px;color:#fff;font-weight:400;transform:translateY(8px);opacity:0;transition:all .35s ease .08s}
.card:hover .rd{background:var(--accent);border-color:var(--accent)}
.meta{display:flex;justify-content:space-between}
.vol{font-size:10px;letter-spacing:2px;color:var(--dim);font-weight:300}
.dt{font-size:10px;color:var(--dimmer)}

.year-divider{padding:80px clamp(20px,5vw,80px) 0}
.year-divider-line{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent)}

.sub-cta{padding:80px clamp(20px,5vw,80px);text-align:center;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin:40px clamp(20px,5vw,80px) 80px}
.sub-cta h3{font-family:var(--display);font-size:clamp(24px,3vw,36px);font-weight:700;letter-spacing:-.5px;margin-bottom:12px}
.sub-cta p{font-size:13px;color:var(--dim);font-weight:300;line-height:1.6;max-width:480px;margin:0 auto 28px}
.sub-btn{display:inline-block;padding:13px 40px;border:1px solid rgba(255,255,255,.3);color:#fff;font-size:11px;letter-spacing:4px;font-family:var(--sans);font-weight:400;cursor:pointer;transition:all .3s;background:transparent}
.sub-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff}

footer{padding:40px clamp(20px,5vw,80px);text-align:center;border-top:1px solid var(--border)}
footer p{font-size:11px;color:var(--dimmer);letter-spacing:1px;margin-bottom:6px}
footer a{color:var(--dim);transition:color .3s}
footer a:hover{color:#fff}


/* ══════ SUBSCRIBE MODAL ══════ */
.sub-modal-overlay{position:fixed;inset:0;z-index:9000;background:rgba(0,0,0,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);display:none;align-items:center;justify-content:center;opacity:0;transition:opacity .35s}
.sub-modal-overlay.active{display:flex;opacity:1}
.sub-modal{background:#111;border:1px solid rgba(255,255,255,.08);max-width:520px;width:90%;padding:48px 40px;position:relative;text-align:center;animation:modalIn .4s ease}
@keyframes modalIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.sub-modal-close{position:absolute;top:16px;right:20px;background:none;border:none;color:rgba(255,255,255,.4);font-size:24px;cursor:pointer;transition:color .3s;line-height:1}
.sub-modal-close:hover{color:#fff}
.sub-modal-issue{font-size:10px;letter-spacing:4px;color:rgba(255,255,255,.45);margin-bottom:8px}
.sub-modal-title{font-family:var(--display);font-size:28px;font-weight:700;letter-spacing:-.5px;margin-bottom:6px}
.sub-modal-count{font-size:12px;color:rgba(255,255,255,.5);margin-bottom:28px}
.sub-modal-divider{width:40px;height:1px;background:rgba(255,255,255,.15);margin:0 auto 28px}
.sub-modal-desc{font-size:14px;color:rgba(255,255,255,.65);line-height:1.6;margin-bottom:32px}
.sub-modal-plans{display:flex;gap:12px;justify-content:center;margin-bottom:24px;flex-wrap:wrap}
.sub-modal-plan{border:1px solid rgba(255,255,255,.12);padding:20px 24px;min-width:190px;text-align:center;transition:all .3s;cursor:pointer;background:rgba(255,255,255,.02)}
.sub-modal-plan:hover{border-color:rgba(255,255,255,.3);background:rgba(255,255,255,.05)}
.sub-modal-plan.rec{border-color:rgba(137,23,23,.5)}
.sub-modal-plan.rec::after{content:'RECOMMENDED';display:block;font-size:8px;letter-spacing:2px;color:rgba(255,255,255,.4);margin-top:8px}
.smp-name{font-size:10px;letter-spacing:3px;color:rgba(255,255,255,.5);margin-bottom:6px}
.smp-price{font-size:24px;font-weight:300;color:#fff}
.smp-price span{font-size:12px;color:rgba(255,255,255,.35)}
.sub-modal-cta{display:block;width:100%;padding:14px;border:1px solid rgba(255,255,255,.4);color:#fff;font-size:12px;letter-spacing:4px;font-family:var(--sans);font-weight:400;cursor:pointer;transition:all .3s;background:transparent;margin-bottom:16px}
.sub-modal-cta:hover{background:#891717;border-color:#891717}
.sub-modal-preview{background:none;border:none;color:rgba(255,255,255,.5);font-size:12px;letter-spacing:2px;font-family:var(--sans);cursor:pointer;transition:color .3s;padding:8px 0}
.sub-modal-preview:hover{color:#fff}
.sub-modal-note{font-size:10px;color:rgba(255,255,255,.3);margin-top:16px;letter-spacing:.5px}

@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.grid{grid-template-columns:1fr;max-width:360px;margin:0 auto}.sec-head{flex-direction:column;align-items:flex-start;gap:6px}}
