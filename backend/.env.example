# ========================================
# PAP Magazine - Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# For Vercel: add these in Project Settings > Environment Variables

# ── Supabase ──
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_KEY="eyJhbGci..."

# ── JWT (Frontend user auth) ──
JWT_SECRET="generate-a-random-secret-min-32-chars"

# ── Stripe ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STD_M="price_..."
STRIPE_PRICE_STD_Y="price_..."
STRIPE_PRICE_PREM_M="price_..."
STRIPE_PRICE_PREM_Y="price_..."

# ── Frontend URL ──
NEXT_PUBLIC_URL="https://www.pap-magazine.com"

# ── Email (SMTP) — for future use ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@pap-magazine.com"
SMTP_PASS="app-password"
EMAIL_FROM="PAP Magazine <contact@pap-magazine.com>"

# ── Google Analytics ──
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
